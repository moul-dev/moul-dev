{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "moul-dev",
	"main": "dist/server/index.js",
	"compatibility_date": "2025-11-17",
	"compatibility_flags": [
		"nodejs_als",
		"nodejs_compat"
	],
	"assets": {
		"directory": "dist/public",
		"binding": "ASSETS",
		"html_handling": "drop-trailing-slash"
	}
}
